{
  "name": "edtech-ai-salesgenie",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "backend:dev": "python -m uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "backend:test": "cd backend && .venv/Scripts/python -m pytest tests/ -q",
    "server:test": "cd backend && .venv/Scripts/python -m pytest tests/ -q",
    "data:aggregate": "node scripts/aggregate-datasets.mjs",
    "compliance:generate": "node scripts/generate-compliance.mjs",
    "build": "npm run data:aggregate && npm run compliance:generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "hyparquet": "^1.28.2",
    "hyparquet-compressors": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
