[TEMPLATE]
# ------------------------------------------------------------------
# EDTECH AI — environment variables
# Copy to `.env` (project root) and adjust. Never commit `.env`.
# ------------------------------------------------------------------

# --- Frontend (Vite) ---
# Base URL of the EDTECH AI FastAPI backend.
VITE_API_URL=http://localhost:8000

# --- Backend (backend/.env) ---
# The backend reads its own config from `backend/.env` — see
# `backend/.env.example`. Key values:
#   PORT=8000
#   DATABASE_URL=            (empty → embedded SQLite at backend/data/salesgenie.db)
#   JWT_ACCESS_SECRET=...
#   JWT_REFRESH_SECRET=...
#   CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
#   AUTO_SEED=true

# --- Email / SMTP (for password-reset emails) ---
# When not configured, the backend returns reset tokens in dev mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=admissions@edtech-ai.com
